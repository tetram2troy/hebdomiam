# Hebdomiam — lignes à AJOUTER au .env du serveur.
# Les variables partagées (DOMAIN, TZ, SMTP_*) existent déjà : ne pas les dupliquer.

# Mot de passe PostgreSQL du service hebdomiam-db (générer : openssl rand -base64 24)
HEBDOMIAM_POSTGRES_PASSWORD=

# Scelle les cookies de session — SECRET, minimum 32 caractères
# (générer : openssl rand -base64 32)
HEBDOMIAM_SESSION_PASSWORD=

# Optionnelle — import de recettes par photo et repli IA des imports URL.
# Vide ou absente : l'import URL fonctionne (schema.org), l'import photo est
# désactivé proprement. SECRET si renseignée.
HEBDOMIAM_ANTHROPIC_API_KEY=
