# Hebdomiam — lignes à AJOUTER au .env du serveur.
# Les variables partagées (DOMAIN, TZ, SMTP_*) existent déjà : ne pas les dupliquer.

# Mot de passe PostgreSQL du service hebdomiam-db (générer : openssl rand -base64 24)
HEBDOMIAM_POSTGRES_PASSWORD=

# Scelle les cookies de session — SECRET, minimum 32 caractères
# (générer : openssl rand -base64 32)
HEBDOMIAM_SESSION_PASSWORD=

# Optionnelle — import de recettes par photo et repli IA des imports URL.
# Vide ou absente : l'import URL fonctionne (schema.org), l'import photo est
# désactivé proprement. SECRET si renseignée.
HEBDOMIAM_ANTHROPIC_API_KEY=

# Mot de passe du rôle PostgreSQL applicatif « hebdomiam_app » (privilèges
# minimaux, créé par le job de migration). 16 caractères minimum, sans
# caractère spécial d'URL — générer : openssl rand -hex 24
HEBDOMIAM_APP_DB_PASSWORD=

# Adresse de Traefik sur le réseau Docker « proxy », en /32 — le seul appelant
# autorisé à transmettre l'IP client (cf-connecting-ip). REQUIS. Donner une IP
# fixe à Traefik (ipv4_address) plutôt que d'ouvrir tout le sous-réseau : un
# autre conteneur du réseau pourrait sinon forger l'en-tête. La lire avec :
#   docker inspect traefik --format '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}'
HEBDOMIAM_TRUSTED_PROXIES=172.18.0.2/32