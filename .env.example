# ── Production (docker-compose.yml, home lab) ──────────────────────────────
# Domaine du home lab (le sous-domaine recettes.${DOMAIN} est couvert par le
# DNS wildcard et le certificat wildcard existants)
DOMAIN=example.com
POSTGRES_PASSWORD=change-me-strong-password
# Rôle PostgreSQL applicatif « hebdomiam_app » (privilèges minimaux, créé par le
# job migrate). 16 caractères minimum, sans caractère spécial d'URL
# (openssl rand -hex 24).
APP_DB_PASSWORD=change-me-app-role-password
# Minimum 32 caractères — scelle les cookies de session (openssl rand -base64 32)
SESSION_PASSWORD=change-me-with-at-least-32-characters!
# Base des liens dans les courriels (vérification, invitation, réinitialisation).
# REQUISE en production (APP_ENV=production, posé par l'image Docker) : sans
# elle les liens seraient dérivés de l'en-tête Host (influençable par l'appelant).
# En dev, l'origine de la requête sert de repli — inutile de la définir.
# PUBLIC_BASE_URL=https://recettes.example.com
# CIDR (séparés par des virgules) des proxies dont l'en-tête cf-connecting-ip
# est cru — l'adresse de Traefik, idéalement une IP fixe en /32. REQUIS en
# production ; vide en dev (l'IP socket fait foi).
# TRUSTED_PROXIES=172.18.0.2/32

# ── Développement local et e2e ──────────────────────────────────────────────
# Le service `api` de docker-compose.dev.yml a sa propre configuration ;
# cette URL sert aux e2e (seed de l'admin, jetons de courriel).
DATABASE_URL=postgresql://hebdomiam:hebdomiam@localhost:5432/hebdomiam

# ── Import de recettes (M4) ─────────────────────────────────────────────────
# Repli IA pour les URLs sans schema.org + import par photo. Sans clé : l'import
# URL fonctionne (schema.org seul) et l'import photo est désactivé proprement.
# ANTHROPIC_API_KEY=
# Modèle d'extraction (défaut claude-opus-5-5)
# EXTRACTION_MODEL=

# ── Courriels (M5) ───────────────────────────────────────────────────────────
# Relais SMTP partagé du home lab (Brevo). SMTP_HOST est REQUIS en production —
# sans lui, les courriels seraient journalisés en console (repli réservé au dev).
# SMTP_SECURITY : starttls (défaut), tls (TLS implicite, ou port 465), none.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=hebdomiam@example.com

# ── Drapeaux réservés aux tests — REFUSÉS en production ─────────────────────
# (l'API ne démarre pas s'ils sont définis hors APP_ENV=development|test ;
# APP_ENV absent ou inconnu = production)
# IMPORT_ALLOW_PRIVATE=1 → débranche la garde SSRF de l'import URL
#   (autorise IP privées et http:). Posé par e2e/server.ts uniquement.
# TRUST_XFF=1            → fait confiance à X-Forwarded-For pour l'IP client
#   (usurpable), quand l'appelant est dans TRUSTED_PROXIES. En prod l'IP vient
#   de cf-connecting-ip (Cloudflare).
#
# Les anciens noms NUXT_* (DATABASE_URL, SESSION_PASSWORD, PUBLIC_BASE_URL…)
# restent acceptés en repli par l'API.
