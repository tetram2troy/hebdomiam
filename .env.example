# ── Production (docker-compose.yml, home lab) ──────────────────────────────
# Domaine du home lab (le sous-domaine recettes.${DOMAIN} est couvert par le
# DNS wildcard et le certificat wildcard existants)
DOMAIN=example.com
POSTGRES_PASSWORD=change-me-strong-password
# Minimum 32 caractères — scelle les cookies de session (openssl rand -base64 32)
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters!
# Base des liens dans les courriels (vérification, invitation, réinitialisation).
# En dev, l'origine de la requête sert de repli — inutile de la définir.
# NUXT_PUBLIC_BASE_URL=https://recettes.example.com

# ── Développement local (npm run dev + docker-compose.dev.yml) ─────────────
NUXT_DATABASE_URL=postgresql://hebdomiam:hebdomiam@localhost:5432/hebdomiam

# ── Import de recettes (M4) ─────────────────────────────────────────────────
# Repli IA pour les URLs sans schema.org + import par photo. Sans clé : l'import
# URL fonctionne (schema.org seul) et l'import photo est désactivé proprement.
# ANTHROPIC_API_KEY=
# Modèle d'extraction (défaut claude-opus-4-8 ; claude-haiku-4-5 = économique, D9)
# NUXT_EXTRACTION_MODEL=

# ── Courriels (M5) ───────────────────────────────────────────────────────────
# Relais SMTP partagé du home lab (Brevo). Sans SMTP_HOST : les courriels sont
# journalisés en console (dev).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=hebdomiam@example.com
