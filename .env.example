# ── Production (docker-compose.yml, home lab) ──────────────────────────────
# Domaine du home lab (le sous-domaine hebdomiam.${DOMAIN} est couvert par le
# DNS wildcard et le certificat wildcard existants)
DOMAIN=example.com
POSTGRES_PASSWORD=change-me-strong-password
# Minimum 32 caractères — chiffre les cookies de session
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters!

# ── Développement local (npm run dev + docker-compose.dev.yml) ─────────────
NUXT_DATABASE_URL=postgresql://hebdomiam:hebdomiam@localhost:5432/hebdomiam

# ── Import de recettes (M4) ─────────────────────────────────────────────────
# Repli IA pour les URLs sans schema.org + import par photo. Sans clé : l'import
# URL fonctionne (schema.org seul) et l'import photo est désactivé proprement.
# ANTHROPIC_API_KEY=
# Modèle d'extraction (défaut claude-opus-4-8 ; claude-haiku-4-5 = économique, D9)
# NUXT_EXTRACTION_MODEL=

# ── À venir (M5) ─────────────────────────────────────────────────────────────
# SMTP_HOST=                  # relais SMTP partagé du home lab (Brevo)
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=hebdomiam@example.com
