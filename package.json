{
  "name": "hebdomiam",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:up": "docker compose -f docker-compose.dev.yml up -d",
    "api:logs": "docker compose -f docker-compose.dev.yml logs -f api",
    "api:test": "docker compose -f docker-compose.dev.yml run --rm api cargo test",
    "api:lint": "docker compose -f docker-compose.dev.yml run --rm --no-deps api sh -c \"cargo fmt --check && cargo clippy --all-targets -- -D warnings\"",
    "api:fmt": "docker compose -f docker-compose.dev.yml run --rm --no-deps api cargo fmt",
    "api:cargo": "docker compose -f docker-compose.dev.yml run --rm api cargo"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@intlify/vue-i18n-extensions": {
      "vue-i18n": "^11.4.20",
      "@intlify/shared": "^11.4.20"
    }
  }
}
